    },
    {
      "cell_type": "markdown",
      "source": [
        "Декораторы для методов\n",
        "Методы — это те же функции, но первым аргументом принимают self."
      ],
      "metadata": {
        "id": "E-2plPgFBIyY"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def method_friendly_decorator(method_to_decorate):\n",
        "    def wrapper(self, lie):\n",
        "        lie -= 3\n",
        "        return method_to_decorate(self, lie)\n",
        "    return wrapper\n",
        "\n",
        "class Lucy:\n",
        "    def __init__(self):\n",
        "        self.age = 32\n",
        "\n",
        "    @method_friendly_decorator\n",
        "    def sayYourAge(self, lie):\n",
        "        print(f\"Мне {self.age + lie} лет\")\n",
        "\n",
        "l = Lucy()\n",
        "l.sayYourAge(-3)"
      ],
      "metadata": {
