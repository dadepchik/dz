        "def solve_task_1():\n",
        "    n, k = map(int, input().split())\n",
        "    closed = set()\n",
        "    if k > 0:\n",
        "        closed = set(map(int, input().split()))\n",
        "\n",
        "    MOD = 10**9 + 7\n",
        "\n",
        "    if 1 in closed:\n",
        "        dp1 = 0\n",
        "    else:\n",
        "        dp1 = 1\n",
        "\n",
        "    if n == 1:\n",
        "        print(dp1)\n",
        "        return\n",
        "\n",
        "    if 2 in closed:\n",
        "        dp2 = 0\n",
        "    else:\n",
        "        dp2 = (1 + dp1) % MOD\n",
        "\n",
        "    if n == 2:\n",
        "        print(dp2)\n",
        "        return\n",
        "\n",
        "    for i in range(3, n + 1):\n",
        "        if i in closed:\n",
        "            dp_i = 0\n",
        "        else:\n",
        "            dp_i = (dp1 + dp2) % MOD\n",
        "        dp1, dp2 = dp2, dp_i\n",
        "\n",
        "    print(dp2)\n",
        "\n",
        "solve_task_1()"
      ],
